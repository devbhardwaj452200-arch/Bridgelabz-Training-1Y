import java.util.Scanner;

public class RockPaperScissors {

    // Method to get computer choice randomly
    public static String getComputerChoice() {
        double rand = Math.random();
        if (rand < 1.0 / 3) return "rock";
        else if (rand < 2.0 / 3) return "paper";
        else return "scissors";
    }

    // Method to determine the winner of one game
    public static String findWinner(String userChoice, String computerChoice) {
        userChoice = userChoice.toLowerCase();
        computerChoice = computerChoice.toLowerCase();

        if (userChoice.equals(computerChoice)) {
            return "Draw";
        } else if ((userChoice.equals("rock") && computerChoice.equals("scissors")) ||
                   (userChoice.equals("paper") && computerChoice.equals("rock")) ||
                   (userChoice.equals("scissors") && computerChoice.equals("paper"))) {
            return "User";
        } else {
            return "Computer";
        }
    }

    // Method to calculate stats: number of wins, percentage
    public static String[][] calculateStats(int userWins, int computerWins, int draws, int totalGames) {
        String[][] stats = new String[4][2];
        stats[0][0] = "Total Games"; stats[0][1] = String.valueOf(totalGames);
        stats[1][0] = "User Wins"; stats[1][1] = String.valueOf(userWins);
        stats[2][0] = "Computer Wins"; stats[2][1] = String.valueOf(computerWins);
        stats[3][0] = "Draws"; stats[3][1] = String.valueOf(draws);
        return stats;
    }

    // Method to calculate winning percentages
    public static String[][] calculatePercentages(int userWins, int computerWins, int draws, int totalGames) {
        String[][] percentages = new String[3][2];
        double userPercent = totalGames == 0 ? 0 : (userWins * 100.0 / totalGames);
        double computerPercent = totalGames == 0 ? 0 : (computerWins * 100.0 / totalGames);
        double drawPercent = totalGames == 0 ? 0 : (draws * 100.0 / totalGames);

        percentages[0][0] = "User Win %"; percentages[0][1] = String.format("%.2f", userPercent);
        percentages[1][0] = "Computer Win %"; percentages[1][1] = String.format("%.2f", computerPercent);
        percentages[2][0] = "Draw %"; percentages[2][1] = String.format("%.2f", drawPercent);

        return percentages;
    }

    // Method to display game results
    public static void displayResults(String[][] gameResults, String[][] stats, String[][] percentages) {
        System.out.println("\nGame Results:");
        System.out.printf("%-10s %-10s %-10s%n", "Game", "User", "Computer");
        System.out.println("------------------------------");
        for (int i = 0; i < gameResults.length; i++) {
            System.out.printf("%-10s %-10s %-10s%n", (i + 1), gameResults[i][0], gameResults[i][1]);
        }

        System.out.println("\nOverall Stats:");
        System.out.printf("%-15s %-10s%n", "Category", "Count");
        System.out.println("-----------------------");
        for (int i = 0; i < stats.length; i++) {
            System.out.printf("%-15s %-10s%n", stats[i][0], stats[i][1]);
        }

        System.out.println("\nWinning Percentages:");
        System.out.printf("%-15s %-10s%n", "Category", "Percentage");
        System.out.println("-----------------------");
        for (int i = 0; i < percentages.length; i++) {
            System.out.printf("%-15s %-10s%n", percentages[i][0], percentages[i][1]);
        }
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter number of games to play: ");
        int n = scanner.nextInt();
        scanner.nextLine(); // consume newline

        String[][] gameResults = new String[n][2];
        int userWins = 0, computerWins = 0, draws = 0;

        for (int i = 0; i < n; i++) {
            System.out.print("Enter your choice (rock/paper/scissors) for game " + (i + 1) + ": ");
            String userChoice = scanner.nextLine().toLowerCase();

            // Validate input
            while (!userChoice.equals("rock") && !userChoice.equals("paper") && !userChoice.equals("scissors")) {
                System.out.print("Invalid choice! Enter rock, paper, or scissors: ");
                userChoice = scanner.nextLine().toLowerCase();
            }

            String computerChoice = getComputerChoice();
            String winner = findWinner(userChoice, computerChoice);

            gameResults[i][0] = userChoice;
            gameResults[i][1] = computerChoice;

            if (winner.equals("User")) userWins++;
            else if (winner.equals("Computer")) computerWins++;
            else draws++;
        }

        String[][] stats = calculateStats(userWins, computerWins, draws, n);
        String[][] percentages = calculatePercentages(userWins, computerWins, draws, n);

        displayResults(gameResults, stats, percentages);

        scanner.close();
    }
}
