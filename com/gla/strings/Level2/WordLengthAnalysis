import java.util.Scanner;

public class WordLengthAnalysis {

    // Method to find the length of a string without using length()
    public static int findLength(String str) {
        int count = 0;
        try {
            while (true) {
                str.charAt(count);
                count++;
            }
        } catch (IndexOutOfBoundsException e) {
            // End of string reached
        }
        return count;
    }

    // Method to split text into words without using split()
    public static String[] customSplit(String str) {
        int length = findLength(str);
        int wordCount = 0;
        boolean inWord = false;

        // Count words
        for (int i = 0; i < length; i++) {
            if (str.charAt(i) != ' ' && !inWord) {
                wordCount++;
                inWord = true;
            } else if (str.charAt(i) == ' ') {
                inWord = false;
            }
        }

        String[] words = new String[wordCount];
        int wordIndex = 0;
        StringBuilder sb = new StringBuilder();

        // Extract words
        for (int i = 0; i < length; i++) {
            char c = str.charAt(i);
            if (c != ' ') {
                sb.append(c);
            } else if (sb.length() > 0) {
                words[wordIndex++] = sb.toString();
                sb = new StringBuilder();
            }
        }
        if (sb.length() > 0) {
            words[wordIndex] = sb.toString();
        }

        return words;
    }

    // Method to create a 2D array of words and their lengths
    public static String[][] wordsWithLengths(String[] words) {
        String[][] result = new String[words.length][2];
        for (int i = 0; i < words.length; i++) {
            result[i][0] = words[i]; // Word
            result[i][1] = String.valueOf(findLength(words[i])); // Length as string
        }
        return result;
    }

    // Method to find the shortest and longest word lengths
    public static int[] findShortestLongest(String[][] wordLengthArray) {
        if (wordLengthArray.length == 0) return new int[]{0, 0};

        int minLength = Integer.parseInt(wordLengthArray[0][1]);
        int maxLength = Integer.parseInt(wordLengthArray[0][1]);

        for (int i = 1; i < wordLengthArray.length; i++) {
            int len = Integer.parseInt(wordLengthArray[i][1]);
            if (len < minLength) minLength = len;
            if (len > maxLength) maxLength = len;
        }

        return new int[]{minLength, maxLength};
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        // Take user input
        System.out.print("Enter a sentence: ");
        String input = scanner.nextLine();

        // Split into words
        String[] words = customSplit(input);

        // Get 2D array of words and their lengths
        String[][] wordLengthArray = wordsWithLengths(words);

        // Display words and lengths
        System.out.printf("%-20s %s%n", "Word", "Length");
        System.out.println("-------------------- ------");
        for (int i = 0; i < wordLengthArray.length; i++) {
            System.out.printf("%-20s %d%n", wordLengthArray[i][0], Integer.parseInt(wordLengthArray[i][1]));
        }

        // Find shortest and longest word lengths
        int[] shortestLongest = findShortestLongest(wordLengthArray);

        System.out.println("\nShortest word length: " + shortestLongest[0]);
        System.out.println("Longest word length: " + shortestLongest[1]);

        scanner.close();
    }
}
